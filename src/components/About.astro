---
import { siteConfig } from "../config";
---

<section id="about" class="px-6 py-20 sm:px-10 sm:py-24 lg:px-16">
  <div class="mx-auto max-w-6xl">
    <div class="mb-10">
      <p
        class="mb-3 text-xs font-bold uppercase tracking-[0.24em]"
        style={`color: ${siteConfig.secondaryColor}`}
      >
        Athlete · Student · Creator
      </p>
      <h2 class="text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl">
        About Rayane
      </h2>
      <div class="mt-4 flex gap-1">
        <span
          class="h-1 w-14 rounded-full"
          style={`background-color: ${siteConfig.accentColor}`}
        />
        <span
          class="h-1 w-6 rounded-full"
          style={`background-color: ${siteConfig.secondaryColor}`}
        />
      </div>
    </div>

    <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="relative mx-auto w-full max-w-sm lg:col-span-5 lg:max-w-none">
        <div
          class="absolute -bottom-3 -right-3 h-full w-full rounded-3xl"
          style={`background-color: ${siteConfig.secondaryColor}`}
        />
        <div class="relative overflow-hidden rounded-3xl border-4 border-white bg-gray-100 shadow-xl">
          <img
            src={`${import.meta.env.BASE_URL}/${siteConfig.profileImage}`}
            alt="Portrait of Rayane Sdiri"
            class="aspect-[3/4] w-full object-cover object-[center_30%]"
            loading="lazy"
            decoding="async"
          />
          <div
            class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/75 to-transparent px-6 pb-6 pt-16 text-white"
          >
            <p class="text-lg font-semibold">Rayane Sdiri</p>
            <p class="mt-1 text-sm text-white/85">Moroccan National Team · Épée</p>
          </div>
        </div>
      </div>

      <div class="lg:col-span-7">
        <h3 class="text-2xl font-semibold leading-snug text-gray-900 sm:text-3xl">
          Driven by the discipline of fencing and the power of sport to bring people together.
        </h3>
        <p class="mt-6 text-base leading-8 text-gray-600 sm:text-lg">
          {siteConfig.aboutMe}
        </p>

        <blockquote
          class="mt-7 border-l-4 py-1 pl-5 text-lg font-medium italic leading-relaxed text-gray-800"
          style={`border-color: ${siteConfig.accentColor}`}
        >
          “{siteConfig.quote}”
        </blockquote>

        <div class="mt-9 grid grid-cols-1 gap-3 sm:grid-cols-3">
          {
            siteConfig.stats.map((stat, index) => (
              <div
                class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm"
                style={`border-top: 3px solid ${index === 1 ? siteConfig.secondaryColor : siteConfig.accentColor}`}
              >
                <p class="text-xl font-bold tracking-tight text-gray-900 sm:text-2xl">
                  {stat.value}
                </p>
                <p class="mt-1 text-xs leading-5 text-gray-600">{stat.label}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <div id="highlights" class="mt-24 scroll-mt-24">
      <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p
            class="text-xs font-bold uppercase tracking-[0.2em]"
            style={`color: ${siteConfig.accentColor}`}
          >
            On the piste
          </p>
          <h3 class="mt-2 text-3xl font-bold text-gray-900 sm:text-4xl">
            Competition highlights
          </h3>
        </div>
        <span class="text-sm text-gray-500">Selected results · 2023–2026</span>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          siteConfig.highlights.map((highlight, index) => (
            <article class="rounded-2xl border border-gray-200 bg-gray-50 p-5 transition-colors hover:bg-white">
              <div class="mb-5 flex items-center justify-between">
                <span
                  class="text-sm font-bold"
                  style={`color: ${index % 2 === 0 ? siteConfig.accentColor : siteConfig.secondaryColor}`}
                >
                  {highlight.period}
                </span>
                <span class="h-px w-10 bg-gray-300" />
              </div>
              <h4 class="text-lg font-bold text-gray-900">{highlight.title}</h4>
              <p class="mt-2 text-sm leading-6 text-gray-600">{highlight.detail}</p>
            </article>
          ))
        }
      </div>
    </div>

    <div class="mt-24">
      <div class="mb-8">
        <p
          class="text-xs font-bold uppercase tracking-[0.2em]"
          style={`color: ${siteConfig.secondaryColor}`}
        >
          What I bring
        </p>
        <h3 class="mt-2 text-3xl font-bold text-gray-900 sm:text-4xl">
          Skills & strengths
        </h3>
      </div>
      <div class="flex flex-wrap gap-3 border-t-2 border-gray-200 pt-5">
        {
          siteConfig.skills.map((skill, index) => (
            <span
              class="rounded-full px-4 py-2 text-sm font-medium"
              style={`background-color: ${index % 2 === 0 ? `${siteConfig.secondaryColor}12` : `${siteConfig.accentColor}10`}; color: ${index % 2 === 0 ? siteConfig.secondaryColor : siteConfig.deepAccentColor}`}
            >
              {skill}
            </span>
          ))
        }
      </div>
    </div>
  </div>
</section>
