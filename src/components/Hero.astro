---
import { siteConfig } from "../config";
---

<section
  id="hero"
  class="relative isolate flex min-h-[720px] items-center overflow-hidden bg-white px-6 pb-24 pt-32 sm:px-10 lg:min-h-screen lg:px-16"
>
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
    <div
      class="absolute -right-36 -top-32 h-[34rem] w-[34rem] rotate-12 rounded-[8rem] border-[28px] opacity-[0.07]"
      style={`border-color: ${siteConfig.accentColor}`}
    />
    <div
      class="absolute -bottom-48 right-[10%] h-[42rem] w-40 -rotate-[28deg] opacity-[0.06]"
      style={`background-color: ${siteConfig.secondaryColor}`}
    />
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_15%_20%,rgba(214,0,0,0.07),transparent_38%),radial-gradient(ellipse_at_90%_85%,rgba(24,92,40,0.07),transparent_38%)]" />
  </div>

  <div class="mx-auto grid w-full max-w-6xl items-center gap-14 lg:grid-cols-12">
    <div class="lg:col-span-8">
      <p
        class="mb-6 flex items-center gap-3 text-xs font-bold uppercase tracking-[0.24em] sm:text-sm"
        style={`color: ${siteConfig.secondaryColor}`}
      >
        <span
          class="h-[3px] w-9 rounded-full"
          style={`background-color: ${siteConfig.accentColor}`}
        />
        Moroccan Épée Fencer
      </p>
      <h1 class="max-w-4xl text-5xl font-bold leading-[1.05] tracking-tight text-gray-950 sm:text-6xl md:text-7xl xl:text-8xl">
        Rayane <span style={`color: ${siteConfig.deepAccentColor}`}>Sdiri</span>
      </h1>
      <p class="mt-7 max-w-3xl text-lg font-semibold leading-relaxed text-gray-700 sm:text-xl">
        National-team fencer, three-time Moroccan champion, and Sports Technology student.
      </p>
      <p class="mt-4 max-w-2xl text-base leading-7 text-gray-600 sm:text-lg">
        Competing with purpose, supporting the fencing community, and sharing the sporting life through content.
      </p>

      <div class="mt-9 flex flex-wrap gap-3">
        <a
          href="#about"
          class="inline-flex items-center gap-2 rounded-full px-6 py-3 text-sm font-semibold text-white transition-transform hover:-translate-y-0.5"
          style={`background-color: ${siteConfig.secondaryColor}`}
        >
          Explore my journey
          <span aria-hidden="true">↓</span>
        </a>
        <a
          href={`mailto:${siteConfig.social.email}`}
          class="inline-flex items-center rounded-full border border-gray-300 bg-white/80 px-6 py-3 text-sm font-semibold text-gray-800 transition-colors hover:border-gray-500"
        >
          Get in touch
        </a>
      </div>

      <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm font-medium text-gray-600">
        <a
          href={siteConfig.social.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors hover:text-[var(--link-accent)]"
          style={`--link-accent: ${siteConfig.accentColor}`}
        >
          LinkedIn <span aria-hidden="true">↗</span>
        </a>
        <a
          href={siteConfig.social.tiktok}
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors hover:text-[var(--link-accent)]"
          style={`--link-accent: ${siteConfig.accentColor}`}
        >
          TikTok <span aria-hidden="true">↗</span>
        </a>
        <a
          href={siteConfig.social.github}
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors hover:text-[var(--link-accent)]"
          style={`--link-accent: ${siteConfig.accentColor}`}
        >
          GitHub <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <div class="relative mx-auto hidden w-full max-w-xs lg:col-span-4 lg:block">
      <div
        class="absolute -inset-5 rotate-6 rounded-[2rem] opacity-10"
        style={`background-color: ${siteConfig.accentColor}`}
      />
      <div class="relative rounded-[2rem] border border-gray-200 bg-white/90 p-8 shadow-xl backdrop-blur">
        <p
          class="text-xs font-bold uppercase tracking-[0.2em]"
          style={`color: ${siteConfig.accentColor}`}
        >
          The pursuit
        </p>
        <p class="mt-8 text-5xl font-bold tracking-tight text-gray-900">03×</p>
        <p class="mt-2 text-sm font-semibold text-gray-700">
          Moroccan national champion
        </p>
        <div class="my-7 h-px bg-gray-200" />
        <p class="text-2xl font-semibold leading-snug text-gray-900">
          “{siteConfig.quote}”
        </p>
        <div class="mt-8 flex gap-1">
          <span
            class="h-1 w-12 rounded-full"
            style={`background-color: ${siteConfig.accentColor}`}
          />
          <span
            class="h-1 w-5 rounded-full"
            style={`background-color: ${siteConfig.secondaryColor}`}
          />
        </div>
      </div>
    </div>
  </div>
</section>
